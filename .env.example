NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://hod:hod@postgres:5432/hod
REDIS_URL=redis://redis:6379
WORKSPACE_DEFAULT_TIMEZONE=UTC
MAX_TRANSPORT=disabled
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_VERSION=2026-07-01
MAX_CA_BUNDLE_PATH=./serifo/max-ca-bundle.pem
MAX_WEBHOOK_PUBLIC_URL=
MAX_WEBHOOK_SECRET=
MAX_MINIAPP_BOT_NAME=
AI_PROVIDER=disabled
AI_HIGH_CONFIDENCE_THRESHOLD=0.85
AI_MEDIUM_CONFIDENCE_THRESHOLD=0.60

# GigaChat AI (backend only)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_TIMEOUT_MS=60000
GIGACHAT_CA_BUNDLE_PATH=./serifo/gigachat-ca-bundle.pem
MINIAPP_SESSION_TTL_SECONDS=28800
MAX_INIT_DATA_MAX_AGE_SECONDS=300
REMINDER_LEAD_MINUTES=60
REMINDER_SCAN_INTERVAL_SECONDS=60
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETENTION_DAYS=7
MAX_RATE_LIMIT_PER_SECOND=10
PROOF_STORAGE_PATH=/data/proofs
PROOF_MAX_BYTES=10485760
MINIAPP_ORIGIN=http://localhost:8080
